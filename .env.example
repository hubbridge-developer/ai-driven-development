# Django
DJANGO_SECRET_KEY=change-me-in-production
DEBUG=True

# Database
DATABASE_URL=postgresql://aidd:aidd@postgres:5432/aidd

# Redis
REDIS_URL=redis://redis:6379/0

# LLM Provider: "ollama" | "litellm" | "claude" | "vertex"
LLM_PROVIDER=ollama

# Anthropic (for litellm or claude provider)
ANTHROPIC_API_KEY=

# Google Vertex AI (GCP-native, used when LLM_PROVIDER=vertex).
# On GKE prefer Workload Identity; off-cluster set GOOGLE_APPLICATION_CREDENTIALS.
VERTEX_PROJECT=
VERTEX_LOCATION=us-central1

# Qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_SPEC_COLLECTION=spec_embeddings

# GitHub
GITHUB_PAT=
SPEC_REPO_URL=
# Account (user or org) that owns the spec + code repos. Change this for a new
# deployment; repo names below are prefixed with it when they have no owner.
GITHUB_OWNER=hubbridge-developer
# Target code repo (bare name → prefixed with GITHUB_OWNER, or full owner/name).
CODE_REPO=xspec-demo-app
SPEC_REPO_NAME=xspec-specs

# Workflow
MAX_REVISION_CYCLES=3
CODE_CONTEXT_MAX_CHARS=4000
RUN_GENERATED_TESTS=true
TEST_RUN_TIMEOUT=180
DUPLICATE_SIMILARITY_THRESHOLD=0.85
RELATED_SPEC_THRESHOLD=0.65
RELEVANCE_THRESHOLD=0.30
ENABLE_QUERY_EXPANSION=true

# Encryption
ENCRYPTION_KEY=
