# Django
DJANGO_SECRET_KEY=change-me-in-production
DEBUG=True

# Django admin (auto-created on a fresh DB by docker-compose; override for non-local)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=admin

# Database
DATABASE_URL=postgresql://add:add@postgres:5432/add

# Redis
REDIS_URL=redis://redis:6379/0

# LLM Provider: "ollama" | "litellm" | "claude" | "vertex" | "gemini" | "groq"
LLM_PROVIDER=ollama

# Per-agent model map. Pick the file that matches LLM_PROVIDER:
#   config/llm_routing_ollama.yaml       (free, local, open-source)
#   config/llm_routing_groq_free.yaml    (free tier, global, needs GROQ_API_KEY)
#   config/llm_routing_gemini_free.yaml  (free tier — NOT available in all regions)
#   config/llm_routing_vertex.yaml       (GCP-billed)
LLM_ROUTING_CONFIG=config/llm_routing_ollama.yaml

# Anthropic (for litellm or claude provider)
ANTHROPIC_API_KEY=

# Groq FREE tier (used when LLM_PROVIDER=groq). Global, fast, no card.
# Get a key at https://console.groq.com
GROQ_API_KEY=

# Google AI Studio Gemini free tier (used when LLM_PROVIDER=gemini).
# NOTE: the free tier is NOT offered in every region (some require prepay billing).
GEMINI_API_KEY=

# Google Vertex AI (GCP-native, used when LLM_PROVIDER=vertex).
# On GKE prefer Workload Identity; off-cluster set GOOGLE_APPLICATION_CREDENTIALS.
VERTEX_PROJECT=
VERTEX_LOCATION=us-central1

# Qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_SPEC_COLLECTION=spec_embeddings

# GitHub
GITHUB_PAT=
SPEC_REPO_URL=
# Account (user or org) that owns the spec + code repos. Change this for a new
# deployment; repo names below are prefixed with it when they have no owner.
GITHUB_OWNER=hubbridge-developer
# Target code repo (bare name → prefixed with GITHUB_OWNER, or full owner/name).
CODE_REPO=xspec-demo-app
SPEC_REPO_NAME=xspec-specs

# Workflow
MAX_REVISION_CYCLES=3
CODE_CONTEXT_MAX_CHARS=4000
RUN_GENERATED_TESTS=true
TEST_RUN_TIMEOUT=180
DUPLICATE_SIMILARITY_THRESHOLD=0.85
RELATED_SPEC_THRESHOLD=0.65
RELEVANCE_THRESHOLD=0.30
ENABLE_QUERY_EXPANSION=true

# Encryption
ENCRYPTION_KEY=
